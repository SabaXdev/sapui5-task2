<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="addBookDialog"
        title="Add Book"
        contentWidth="22rem">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="ID" required="true"/>
                <Input
                    id="addBookIdInput"
                    value="{newBook>/ID}"
                    maxLength="20"
                    placeholder="Book ID"
                    width="100%"/>
                <Label text="Title" required="true"/>
                <Input
                    id="addBookNameInput"
                    value="{newBook>/Name}"
                    maxLength="200"
                    placeholder="Title"
                    width="100%"/>
                <Label text="Author" required="true"/>
                <Input
                    id="addBookAuthorInput"
                    value="{newBook>/Author}"
                    maxLength="200"
                    placeholder="Author"
                    width="100%"/>
                <Label text="Genre" required="true"/>
                <Input
                    id="addBookGenreInput"
                    value="{newBook>/Genre}"
                    maxLength="100"
                    placeholder="Genre"
                    width="100%"/>
                <Label text="Release Date" required="true"/>
                <DatePicker
                    id="addBookReleaseDateInput"
                    value="{
                        path: 'newBook>/ReleaseDate',
                        type: 'sap.ui.model.type.Date',
                        formatOptions: {
                            strictParsing: true,
                            pattern: 'yyyy-MM-dd'
                        }
                    }"
                    displayFormat="medium"
                    valueFormat="yyyy-MM-dd"
                    width="100%"/>
                <Label text="Available Quantity" required="true"/>
                <Input
                    id="addBookQuantityInput"
                    value="{newBook>/AvailableQuantity}"
                    type="Number"
                    placeholder="Quantity"
                    width="100%"/>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Add"
                type="Emphasized"
                press=".onConfirmAddBook"/>
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelAddBook"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
