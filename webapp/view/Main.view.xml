<mvc:View controllerName="axalimoduli.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Table id="booksTable"
            inset="false"
            width="auto"
            items="{/books}">
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Books" level="H2"/>
                </OverflowToolbar>
            </headerToolbar>
            <columns>
                <Column width="6rem">
                    <Text text="ID"/>
                </Column>
                <Column>
                    <Text text="Name"/>
                </Column>
                <Column minScreenWidth="Tablet" demandPopin="true">
                    <Text text="Author"/>
                </Column>
                <Column minScreenWidth="Tablet" demandPopin="true">
                    <Text text="Genre"/>
                </Column>
                <Column minScreenWidth="Desktop" demandPopin="true">
                    <Text text="Release Date"/>
                </Column>
                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                    <Text text="Available Quantity"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem vAlign="Middle">
                    <cells>
                        <Text text="{ID}"/>
                        <Text text="{Name}"/>
                        <Text text="{Author}"/>
                        <Text text="{Genre}"/>
                        <Text text="{
                            path: 'ReleaseDate',
                            type: 'sap.ui.model.type.Date',
                            formatOptions: {
                                style: 'medium'
                            }
                        }"/>
                        <ObjectNumber number="{AvailableQuantity}" emphasized="false"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>