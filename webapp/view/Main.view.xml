<mvc:View controllerName="axalimoduli.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Table id="booksTable"
            mode="MultiSelect"
            inset="false"
            width="auto"
            items="{/books}">
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="{i18n>booksTableTitle}" level="H2"/>
                </OverflowToolbar>
            </headerToolbar>
            <toolbar>
                <OverflowToolbar>
                    <Input id="titleFilter"
                        width="12rem"
                        placeholder="{i18n>filterByTitlePlaceholder}"/>
                    <Select id="genreFilter"
                        width="12rem"
                        forceSelection="false"
                        items="{filter>/genres}">
                        <core:Item key="{filter>}" text="{filter>}"/>
                    </Select>
                    <Button id="filterButton"
                        text="{i18n>filterButton}"
                        type="Emphasized"
                        press=".onFilterBooks"/>
                    <ToolbarSeparator/>
                    <Button id="addRecordButton"
                        text="{i18n>addRecordButton}"
                        type="Accept"
                        press=".onAddRecord"/>
                    <Button id="deleteRecordButton"
                        text="{i18n>deleteRecordButton}"
                        type="Reject"
                        press=".onDeleteRecord"/>
                </OverflowToolbar>
            </toolbar>
            <columns>
                <Column width="6rem">
                    <Text text="{i18n>tableColumnId}"/>
                </Column>
                <Column>
                    <Text text="{i18n>tableColumnName}"/>
                </Column>
                <Column minScreenWidth="Tablet" demandPopin="true">
                    <Text text="{i18n>tableColumnAuthor}"/>
                </Column>
                <Column minScreenWidth="Tablet" demandPopin="true">
                    <Text text="{i18n>tableColumnGenre}"/>
                </Column>
                <Column minScreenWidth="Desktop" demandPopin="true">
                    <Text text="{i18n>tableColumnReleaseDate}"/>
                </Column>
                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                    <Text text="{i18n>tableColumnAvailableQuantity}"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem vAlign="Middle">
                    <cells>
                        <Text text="{ID}"/>
                        <Text text="{Name}"/>
                        <Text text="{Author}"/>
                        <Text text="{Genre}"/>
                        <Text text="{
                            parts: [
                                {path: 'ReleaseDate'},
                                {path: 'i18n>publishedYear'}
                            ],
                            formatter: '.formatter.formatPublishedYear'
                        }"/>
                        <ObjectNumber number="{AvailableQuantity}" emphasized="false"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>
