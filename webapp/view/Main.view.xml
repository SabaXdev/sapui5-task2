<mvc:View controllerName="axalimoduli.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Table id="booksTable"
            mode="MultiSelect"
            inset="false"
            width="auto"
            items="{/books}">
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Books" level="H2"/>
                </OverflowToolbar>
            </headerToolbar>
            <toolbar>
                <OverflowToolbar>
                    <Input id="titleFilter"
                        width="12rem"
                        placeholder="Filter by title"/>
                    <Select id="genreFilter"
                        width="12rem"
                        forceSelection="false"
                        items="{filter>/genres}">
                        <core:Item key="{filter>}" text="{filter>}"/>
                    </Select>
                    <Button id="filterButton"
                        text="Filter"
                        type="Emphasized"
                        press=".onFilterBooks"/>
                    <ToolbarSeparator/>
                    <Button id="addRecordButton"
                        text="Add Record"
                        type="Accept"
                        press=".onAddRecord"/>
                    <Button id="deleteRecordButton"
                        text="Delete Record"
                        type="Reject"
                        press=".onDeleteRecord"/>
                </OverflowToolbar>
            </toolbar>
            <columns>
                <Column width="6rem">
                    <Text text="ID"/>
                </Column>
                <Column>
                    <Text text="Title"/>
                </Column>
                <Column minScreenWidth="Tablet" demandPopin="true">
                    <Text text="Author"/>
                </Column>
                <Column minScreenWidth="Tablet" demandPopin="true">
                    <Text text="Genre"/>
                </Column>
                <Column minScreenWidth="Desktop" demandPopin="true">
                    <Text text="Release Date"/>
                </Column>
                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                    <Text text="Available Quantity"/>
                </Column>
                <Column width="8rem" hAlign="Center">
                    <Text text="Actions"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem vAlign="Middle">
                    <cells>
                        <Text text="{ID}"/>
                        <Text text="{Name}" visible="{= !${editMode}}"/>
                        <Input value="{Name}" visible="{editMode}"/>
                        <Text text="{Author}"/>
                        <Text text="{Genre}"/>
                        <Text text="{
                            path: 'ReleaseDate',
                            type: 'sap.ui.model.type.Date',
                            formatOptions: {
                                style: 'medium'
                            }
                        }"/>
                        <ObjectNumber number="{AvailableQuantity}" emphasized="false"/>
                        <HBox justifyContent="Center">
                            <Button text="Edit Title"
                                type="Transparent"
                                visible="{= !${editMode}}"
                                press=".onEditTitle"/>
                            <Button text="Save"
                                type="Emphasized"
                                visible="{editMode}"
                                press=".onSaveTitle"/>
                        </HBox>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>
