<mvc:View controllerName="axalimoduli.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <IconTabBar id="mainTabs" expandable="false" selectedKey="json">
            <items>
                <IconTabFilter id="jsonTab" key="json" text="JSON Model">
                    <Table id="booksTable"
                        mode="MultiSelect"
                        inset="false"
                        width="auto"
                        items="{/books}">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="Books" level="H2"/>
                            </OverflowToolbar>
                        </headerToolbar>
                        <infoToolbar>
                            <OverflowToolbar>
                                <Input id="titleFilter"
                                    width="12rem"
                                    placeholder="Filter by title"/>
                                <Select id="genreFilter"
                                    width="12rem"
                                    forceSelection="false"
                                    items="{filter>/genres}">
                                    <core:Item key="{filter>}" text="{filter>}"/>
                                </Select>
                                <Button id="filterButton"
                                    text="Filter"
                                    type="Emphasized"
                                    press=".onFilterBooks"/>
                                <ToolbarSeparator/>
                                <Button id="addRecordButton"
                                    text="Add Record"
                                    type="Accept"
                                    press=".onAddRecord"/>
                                <Button id="deleteRecordButton"
                                    text="Delete Record"
                                    type="Reject"
                                    press=".onDeleteRecord"/>
                            </OverflowToolbar>
                        </infoToolbar>
                        <columns>
                            <Column width="6rem">
                                <Text text="ID"/>
                            </Column>
                            <Column>
                                <Text text="Name"/>
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Author"/>
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Genre"/>
                            </Column>
                            <Column minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Release Date"/>
                            </Column>
                            <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Available Quantity"/>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem vAlign="Middle">
                                <cells>
                                    <Text text="{ID}"/>
                                    <Text text="{Name}"/>
                                    <Text text="{Author}"/>
                                    <Text text="{Genre}"/>
                                    <Text text="{
                                        path: 'ReleaseDate',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: {
                                            style: 'medium'
                                        }
                                    }"/>
                                    <ObjectNumber number="{AvailableQuantity}" emphasized="false"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </IconTabFilter>
                <IconTabFilter id="odataV2Tab" key="odataV2" text="OData V2 Model">
                    <Table id="productsV2Table"
                        inset="false"
                        items="{oDataV2Model>/Products}">
                        <columns>
                            <Column><Text text="ID"/></Column>
                            <Column><Text text="Name"/></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Description"/></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Release Date"/></Column>
                            <Column><Text text="Rating"/></Column>
                            <Column><Text text="Price"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{oDataV2Model>ID}"/>
                                    <Text text="{oDataV2Model>Name}"/>
                                    <Text text="{oDataV2Model>Description}"/>
                                    <Text text="{oDataV2Model>ReleaseDate}"/>
                                    <Text text="{oDataV2Model>Rating}"/>
                                    <Text text="{oDataV2Model>Price}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </IconTabFilter>
                <IconTabFilter id="odataV4Tab" key="odataV4" text="OData V4 Model">
                    <Table id="peopleV4Table"
                        inset="false"
                        items="{oDataV4Model>/People}">
                        <columns>
                            <Column><Text text="User Name"/></Column>
                            <Column><Text text="First Name"/></Column>
                            <Column><Text text="Last Name"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{oDataV4Model>UserName}"/>
                                    <Text text="{oDataV4Model>FirstName}"/>
                                    <Text text="{oDataV4Model>LastName}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </IconTabFilter>
            </items>
        </IconTabBar>
    </Page>
</mvc:View>
