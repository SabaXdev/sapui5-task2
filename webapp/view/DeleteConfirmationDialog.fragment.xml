<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="deleteConfirmationDialog"
        type="Message"
        title="Confirm">
        <Text text="Are you sure you want to delete selected records?"/>
        <beginButton>
            <Button
                text="Yes"
                type="Emphasized"
                press=".onConfirmDelete"/>
        </beginButton>
        <endButton>
            <Button
                text="No"
                press=".onCancelDelete"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
